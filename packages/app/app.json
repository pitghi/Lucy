{
  "expo": {
    "name": "Lucy",
    "slug": "lucy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": { "backgroundColor": "#F8FAFC", "resizeMode": "contain" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Lucy lit le code-barres des produits pour retrouver leur composition. Aucune image n'est conservee."
      }
    },
    "android": {
      "package": "com.lucy.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": { "bundler": "metro" },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Lucy lit le code-barres des produits pour retrouver leur composition."
        }
      ]
    ]
  }
}
