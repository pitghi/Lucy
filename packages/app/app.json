{
  "expo": {
    "name": "Lucy",
    "slug": "lucy",
    "scheme": "lucy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/5adbde8f-36c2-48be-bcf3-8d499a610044"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/splash.png",
        "backgroundColor": "#0B1220"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pitghi.lucy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pitghi.lucy",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7490"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Lucy lit le code-barres du produit pour retrouver sa composition. Aucune image n'est conservee ni transmise.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5adbde8f-36c2-48be-bcf3-8d499a610044"
      }
    },
    "owner": "pitghi"
  }
}
